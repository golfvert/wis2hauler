# Dependencies
node_modules/

# OS junk
.DS_Store

# Local dev config -- real broker/credential values and machine-specific
# paths (aria-download, aria-url, ...), never meant to leave this machine.
# See fixtures/*.yaml for the sanitized configs the test suite actually
# uses -- those ARE meant to be committed.
dev.yaml

# Node-RED reference export -- the original flow this app was ported
# from (cited throughout src/ comments for cross-checking), not part of
# the Bun app and not needed to build or run it.
nodered/

# Compiled/bundled output (e.g. `bun build --compile`)
wis2hauler
wis2-downloader
*.exe

# Build output staged for a Docker build -- compiled binaries (dist/<arch>/)
# and geoip-lite's .dat files (dist/geoip-data/), whether produced by CI
# (.github/workflows/release.yml) or by a local `docker build` per
# docs/deployment.md. Always regenerated fresh from bun install/build --
# never meant to be committed (found live, 2026-09-13: a local test build
# got `git add -A`'d, pushing 75MB+ .dat files straight into history).
dist/

# Debug marker files -- pre-existing convention, harmless to keep ignoring
*.debug

# Editors
.vscode/
.idea/

# Logs
*.log
logs/

# Env files
.env
.env.*

# Staged for manual deletion (stale binaries, superseded source) --
# never meant to reach the repo either way
_to_delete/
