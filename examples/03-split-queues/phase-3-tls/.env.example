# Copy to .env and fill in a real Infomaniak API token (Infomaniak
# account -> API tokens, scoped to DNS management for the zone
# cache.example.com's real replacement domain lives in). traefik.yml
# maps this into the INFOMANIAK_ACCESS_TOKEN env var lego actually
# expects -- see that file's own comment for why the names differ.
my_dns_enabled_token=
